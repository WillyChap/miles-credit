#!/bin/bash
# =====================================================================================
# PHASE 0  ·  E1 multi-year truth budget  +  E2 float32/64 precision demo
# CPU-only, no GPU queue. See experiments/README.md.
#   E1: extends the ground-truth water budget to 1980-1984 (claim C1)
#   E2: exhibits the ~0.6% float32 accumulation error the fix removes (claim C9)
# Submit:  qsub experiments/pbs/phase0_truth_and_precision.pbs
# Change -A if P93300042 is not your project.
# =====================================================================================
#PBS -N lessons_phase0
#PBS -A P93300042
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -l walltime=06:00:00
#PBS -q casper
#PBS -j oe
#PBS -k eod
#PBS -o /glade/work/wchapman/Roman_Coupling/train_johns/experiments/logs/

set -euo pipefail

source ~/.bashrc
conda activate /glade/work/wchapman/conda-envs/credit-casper-mar2026

REPO=/glade/work/wchapman/Roman_Coupling/train_johns
cd "$REPO"
mkdir -p experiments/out

echo "===== E1: multi-year ground-truth water budget (1980-1984) ====="
python compute_water_budget_truth.py \
    --years 1980-1984 \
    --out experiments/out/water_budget_1980_1984.csv

echo "===== E2: float32 vs float64 global-sum rounding demo ====="
python experiments/float_precision_demo.py \
    --year 1980 --nsteps 20 \
    --out experiments/out/float_precision_demo.txt

echo "===== Phase 0 complete. Outputs in experiments/out/ ====="
