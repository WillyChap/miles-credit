#!/bin/bash
#-*- coding: utf-8 -*-
#PBS -N SUMO_supermodel
#PBS -A NAML0001
#PBS -l walltime=12:00:00
#PBS -o SUMO_supermodel.out
#PBS -e SUMO_supermodel.out
#PBS -q casper
#PBS -l select=1:ncpus=8:ngpus=1:mem=80GB
#PBS -l gpu_type=a100
#PBS -m a
#PBS -M wchapman@ucar.edu

# =============================================================================
# submit_supermodel.pbs
#
# Batch job that launches the SUMO server(s) + coordinator(s) on a Casper
# A100 (80 GB) and stays alive until the coordinator finishes. CESM runs
# separately on Derecho compute nodes -- both jobs share the run directory
# via the file-flag protocol.
#
# Required env vars (pass via `qsub -v`):
#   MODE       - camulator | graphcast | both
#   RUNDIR     - shared run directory (must already exist; this is where
#                CAM6 writes h1 files and the coordinator writes nudge files)
#
# Optional env vars (defaults in code):
#   START_YMD       - default 19800101
#   START_TOD       - default 21600
#   MAX_STEPS       - default 0 (unbounded)
#   CAM6_CASE       - CAM6 case prefix (auto-glob if unset)
#   CAMULATOR_*     - only for --mode camulator|both; see run_coordinators.sh -h
#   POLL_SEC        - heartbeat interval (default 30 s)
#   COORD_HEARTBEAT - log progress to stdout every N polls (default 10 = 5 min)
#
# Usage:
#   qsub -v MODE=graphcast,RUNDIR=/glade/derecho/scratch/wchapman/.../run \\
#        climate/submit_supermodel.pbs
#
# The job:
#   1. Activates the supermodel conda env.
#   2. Calls run_coordinators.sh --action start (which writes PID files and
#      returns).
#   3. Blocks until the coordinator PID exits (clean exit, walltime hit, or
#      external signal).
#   4. On any exit, calls run_coordinators.sh --action stop to shut down
#      every tracked process cleanly. SIGTERM with a grace period, then
#      SIGKILL.
#
# Walltime is 12 hours by default. For a 5-day CAM6 run at 6 SYPD this is
# plenty; bump --walltime above for longer runs.
# =============================================================================

set -euo pipefail

REPO_DIR="${REPO_DIR:-/glade/work/wchapman/Roman_Coupling/camulator_sumo}"
SUPERMODEL_PY="/glade/work/wchapman/conda-envs/supermodel/bin/python"
CONDA_BASE="/glade/work/wchapman/conda-envs/supermodel"

# Resolve required vars (qsub -v sets them; bail clearly if missing).
: "${MODE:?MODE not set; pass via qsub -v MODE=graphcast,...}"
: "${RUNDIR:?RUNDIR not set; pass via qsub -v MODE=...,RUNDIR=/path}"

START_YMD="${START_YMD:-19800101}"
START_TOD="${START_TOD:-21600}"
MAX_STEPS="${MAX_STEPS:-0}"
CAM6_CASE="${CAM6_CASE:-}"
POLL_SEC="${POLL_SEC:-30}"
COORD_HEARTBEAT="${COORD_HEARTBEAT:-10}"

[[ ! -d "$RUNDIR" ]] && { echo "RUNDIR does not exist: $RUNDIR" >&2; exit 2; }

# Setup env
source /etc/profile.d/conda.sh 2>/dev/null || \
  source /glade/u/apps/conda/etc/profile.d/conda.sh 2>/dev/null || true
conda activate "$CONDA_BASE"

echo "================================================================="
echo " SUMO supermodel PBS job"
echo "================================================================="
echo "  mode      : $MODE"
echo "  rundir    : $RUNDIR"
echo "  start ymd : $START_YMD  tod=$START_TOD"
echo "  max steps : ${MAX_STEPS}"
echo "  cam6 case : ${CAM6_CASE:-(auto-glob)}"
echo "  walltime  : $(qstat -f $PBS_JOBID 2>/dev/null | grep Resource_List.walltime | awk '{print $3}' || echo '(unknown)')"
echo "  host      : $(hostname)"
echo "  GPU       : $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1)"
echo "================================================================="

# Trap: on exit (any reason), gracefully shut down everything in the rundir.
# Crucial for walltime hits -- without this, we leak processes that hold
# /glade/work + scratch quotas.
cleanup() {
    local rc=$?
    echo
    echo "[pbs] cleanup triggered (exit $rc)"
    bash "$REPO_DIR/climate/run_coordinators.sh" \
        --mode "$MODE" --rundir "$RUNDIR" --action stop || true
    echo "[pbs] cleanup done."
}
trap cleanup EXIT INT TERM

# Build the run_coordinators.sh start command.
COORD_ARGS=(
    --mode "$MODE"
    --rundir "$RUNDIR"
    --start-ymd "$START_YMD"
    --start-tod "$START_TOD"
)
[[ "$MAX_STEPS" -gt 0 ]] && COORD_ARGS+=(--max-steps "$MAX_STEPS")
[[ -n "$CAM6_CASE" ]]    && COORD_ARGS+=(--cam6-case "$CAM6_CASE")

# Mode-specific extras passed via env (only needed for CAMulator).
if [[ "$MODE" == "camulator" || "$MODE" == "both" ]]; then
    [[ -n "${CAMULATOR_CONFIG:-}" ]]     && COORD_ARGS+=(--camulator-config "$CAMULATOR_CONFIG")
    [[ -n "${CAMULATOR_CHECKPOINT:-}" ]] && COORD_ARGS+=(--camulator-checkpoint "$CAMULATOR_CHECKPOINT")
    [[ -n "${CAMULATOR_IC:-}" ]]         && COORD_ARGS+=(--camulator-ic "$CAMULATOR_IC")
fi

echo "[pbs] starting servers + coordinators..."
bash "$REPO_DIR/climate/run_coordinators.sh" "${COORD_ARGS[@]}"

# Determine which coordinator PID file to block on. If multiple, block on
# whichever stays alive longest (we don't expect both for now).
COORD_PID_FILES=()
case "$MODE" in
    graphcast|both) COORD_PID_FILES+=("$RUNDIR/gc_coordinator.pid") ;;
esac
case "$MODE" in
    camulator|both) COORD_PID_FILES+=("$RUNDIR/camulator_coordinator.pid") ;;
esac

# Wait for the PID files to materialize (run_coordinators.sh returns
# before they're written if it forks via nohup).
for pid_file in "${COORD_PID_FILES[@]}"; do
    for i in $(seq 1 20); do
        [[ -f "$pid_file" ]] && break
        sleep 1
    done
done

# Read PIDs.
COORD_PIDS=()
for pid_file in "${COORD_PID_FILES[@]}"; do
    if [[ -f "$pid_file" ]]; then
        COORD_PIDS+=("$(cat "$pid_file")")
        echo "[pbs] tracking coordinator pid=$(cat "$pid_file") from $pid_file"
    fi
done

if [[ ${#COORD_PIDS[@]} -eq 0 ]]; then
    echo "[pbs] ERROR: no coordinator PID files appeared in $RUNDIR" >&2
    exit 1
fi

# Heartbeat loop: poll periodically, log every COORD_HEARTBEAT polls.
echo "[pbs] entering wait loop; polling every ${POLL_SEC}s"
ITER=0
while true; do
    ALL_DEAD=1
    for pid in "${COORD_PIDS[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            ALL_DEAD=0
            break
        fi
    done
    if [[ $ALL_DEAD -eq 1 ]]; then
        echo "[pbs] all coordinators have exited"
        break
    fi
    if (( ITER % COORD_HEARTBEAT == 0 )); then
        echo "[pbs] heartbeat: $(date +%H:%M:%S) -- coordinators still alive: ${COORD_PIDS[*]}"
        # Show concise status from run_coordinators.sh
        bash "$REPO_DIR/climate/run_coordinators.sh" \
            --mode "$MODE" --rundir "$RUNDIR" --action status 2>&1 \
          | grep -E "(GraphCast|CAMulator|gc_server_ready)" || true
    fi
    ITER=$((ITER + 1))
    sleep "$POLL_SEC"
done

echo "[pbs] coordinators done; trap will clean up servers"
